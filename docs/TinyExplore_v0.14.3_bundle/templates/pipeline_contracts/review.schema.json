{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeCraft phase review 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actor",
    "stage",
    "direction",
    "subject",
    "status",
    "checks",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "package0",
        "package1",
        "package2"
      ]
    },
    "direction": {
      "enum": [
        "IN",
        "OUT"
      ]
    },
    "subject": {
      "$ref": "#/$defs/artifact"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_performed"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "refs",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_performed"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "blocking",
          "refs",
          "observed",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
